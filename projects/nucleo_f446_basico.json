      "description": "Botão azul B1", "active_low": true
    },
    "uart2_tx": {
      "port": "GPIOA", "pin": 2,
      "description": "USART2 TX — conector ST-Link virtual COM",
      "peripheral": { "type": "UART", "name": "USART2", "role": "TX",
                      "params": { "baudrate": 115200 } }
    },
    "uart2_rx": {
      "port": "GPIOA", "pin": 3,
      "description": "USART2 RX — conector ST-Link virtual COM",
      "peripheral": { "type": "UART", "name": "USART2", "role": "RX",
                      "params": { "baudrate": 115200 } }
    }
  },
