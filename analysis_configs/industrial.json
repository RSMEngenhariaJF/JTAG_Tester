{
  "name": "Industrial IEC 61131",
  "description": "Critérios restritos para ambientes industriais. Baseado em IEC 61131-2 e EN 50178.",
  "version": "1.0",
  "author": "",
  "metrics": {
    "uart_ber": {
      "limit_max": 1e-7,
      "description": "BER UART — máx 10^-7 (grau industrial)"
    },
    "uart_rtt": {
      "limit_max": 2.0,
      "description": "Latência round-trip UART — máx 2 ms"
    },
    "bit_period": {
      "tolerance_pct": 1.0,
      "description": "Desvio de período de bit — ±1%"
    },
    "pwm_freq": {
      "tolerance_pct": 0.5,
      "description": "Desvio de frequência PWM — ±0.5%"
    },
    "pwm_jitter": {
      "limit_max": 0.5,
      "description": "Jitter PWM pico-a-pico — máx 0.5% do período"
    },
    "v_3v3": {
      "tolerance_pct": 1.0,
      "nominal": 3.3,
      "description": "Tensão 3.3V — tolerância ±1% (IEC 61131-2)"
    },
    "v_5v0": {
      "tolerance_pct": 2.0,
      "nominal": 5.0,
      "description": "Tensão 5V — tolerância ±2%"
    },
    "v_supply": {
      "tolerance_pct": 2.0,
      "nominal": 24.0,
      "description": "Alimentação 24VDC — tolerância ±2% (EN 50178)"
    },
    "ripple_3v3": {
      "limit_max": 10.0,
      "description": "Ripple pico-a-pico 3.3V — máx 10 mV"
    },
    "ripple_5v0": {
      "limit_max": 25.0,
      "description": "Ripple pico-a-pico 5V — máx 25 mV"
    },
    "can_rtt": {
      "limit_max": 1.0,
      "description": "Latência CAN — máx 1 ms (CAN FD 1 Mbit/s)"
    },
    "i2c_latency": {
      "limit_max": 0.5,
      "description": "Latência I2C — máx 0.5 ms (400 kHz Fast Mode)"
    },
    "spi_ber": {
      "limit_max": 1e-9,
      "description": "BER SPI loopback — máx 10^-9"
    },
    "thd_saida": {
      "limit_max": 0.1,
      "description": "THD saída analógica — máx 0.1%"
    }
  }
}
